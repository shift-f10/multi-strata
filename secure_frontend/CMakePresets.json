{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "secure-frontend-base",
      "hidden": true,
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "BUILD_TESTING": "ON",
        "STRATA_BUILD_SECURE_FRONTEND_TESTS": "ON"
      }
    },
    {
      "name": "linux-gcc",
      "displayName": "Linux GCC",
      "inherits": "secure-frontend-base",
      "generator": "Ninja",
      "environment": {
        "CC": "gcc",
        "CXX": "g++"
      }
    },
    {
      "name": "linux-clang",
      "displayName": "Linux Clang",
      "inherits": "secure-frontend-base",
      "generator": "Ninja",
      "environment": {
        "CC": "clang",
        "CXX": "clang++"
      }
    },
    {
      "name": "windows-msvc",
      "displayName": "Windows MSVC",
      "inherits": "secure-frontend-base",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64"
    },
    {
      "name": "windows-llvm-mingw-cross",
      "displayName": "Windows x86_64 (llvm-mingw cross from Linux)",
      "inherits": "secure-frontend-base",
      "generator": "Ninja",
      "toolchainFile": "${sourceDir}/cmake/toolchains/llvm-mingw-x86_64.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "windows-msys2-clang",
      "displayName": "Windows x86_64 (MSYS2 CLANG64)",
      "inherits": "secure-frontend-base",
      "generator": "Ninja",
      "environment": {
        "CC": "clang",
        "CXX": "clang++"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "linux-gcc",
      "configurePreset": "linux-gcc"
    },
    {
      "name": "linux-clang",
      "configurePreset": "linux-clang"
    },
    {
      "name": "windows-msvc",
      "configurePreset": "windows-msvc",
      "configuration": "Release"
    },
    {
      "name": "windows-llvm-mingw-cross",
      "configurePreset": "windows-llvm-mingw-cross"
    },
    {
      "name": "windows-msys2-clang",
      "configurePreset": "windows-msys2-clang"
    }
  ],
  "testPresets": [
    {
      "name": "linux-gcc",
      "configurePreset": "linux-gcc",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-clang",
      "configurePreset": "linux-clang",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-msvc",
      "configurePreset": "windows-msvc",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-llvm-mingw-cross",
      "configurePreset": "windows-llvm-mingw-cross",
      "output": {
        "outputOnFailure": true
      },
      "environment": {
        "WINEPREFIX": "${sourceDir}/out/wineprefix"
      }
    },
    {
      "name": "windows-msys2-clang",
      "configurePreset": "windows-msys2-clang",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
